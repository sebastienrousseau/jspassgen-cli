{
  "name": "@sebastienrousseau/jspassgen-cli",
  "version": "0.0.22",
  "description": "Command-line password generator built on @sebastienrousseau/jspassgen: strong passwords from the platform CSPRNG, made on your machine.",
  "keywords": [
    "cli",
    "command-line",
    "jspassgen",
    "password",
    "password-generator",
    "csprng",
    "security"
  ],
  "homepage": "https://github.com/sebastienrousseau/jspassgen-cli#readme",
  "bugs": {
    "url": "https://github.com/sebastienrousseau/jspassgen-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/jspassgen-cli.git"
  },
  "license": "Apache-2.0 OR MIT",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/sebastienrousseau"
    }
  ],
  "type": "module",
  "bin": {
    "jspassgen": "bin/jspassgen.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "c8 mocha"
  },
  "dependencies": {
    "@sebastienrousseau/jspassgen": "0.0.22",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1"
  },
  "mocha": {
    "spec": [
      "test/**/*.test.js"
    ],
    "timeout": 20000
  },
  "c8": {
    "all": true,
    "include": [
      "bin/**",
      "src/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
